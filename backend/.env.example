PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/evidencelocker

CLIENT_ORIGIN=http://localhost:5173
SECURITY_SECRET=change-me-for-production
# Set to true only for local development; never enable on networked staging/production
EXPOSE_DEV_OTP=true
CASE_RETENTION_DAYS=90
AUDIT_RETENTION_SECONDS=31536000

# Gemini chatbot (keep this key on the backend only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# SMTP (required in production for email OTP login)
# Gmail: set GMAIL_USER + APP_PASSWORD (spaces in app password are optional)
GMAIL_USER=your@gmail.com
APP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Evidence Locker <your@gmail.com>
